#!/bin/bash
set -uo pipefail
REPO=${REPO:-/work/repo}
CHANGED=${CHANGED:-/work/changed}
KUBE_VERSION=${KUBE_VERSION:-1.35.4}
CATALOG='https://raw.githubusercontent.com/datreeio/CRDs-catalog/main/{{.Group}}/{{.ResourceKind}}_{{.ResourceAPIVersion}}.json'
OUT=$(mktemp -d)
skip() { echo "SKIP $1"; exit 75; }
cd "$REPO" || skip "no checkout at $REPO"
[ -f "$CHANGED" ] || skip "no list of changed files"
[ ! -e "$CHANGED.truncated" ] || skip "too many changed files"
fail=0
dirs=""
values=""
while IFS= read -r f; do
  case "$f" in
    .*/* | */.*/* | */testdata/* | testdata/* | */templates/* | */charts/*/* ) continue ;;
    */*.yaml | */*.yml) ;;
    *) continue ;;
  esac
  case "$f" in
    */apps/*.yml | */apps/*.yaml) [ ! -e "$f" ] || skip "not rendered: $f (Argo CD Application)"; continue ;;
    */app-values/*) [ ! -e "$f" ] || values="$values $f"; continue ;;
  esac
  d=$(dirname "$f")
  while [ ! -d "$d" ] && [ "$d" != . ]; do d=$(dirname "$d"); done
  k=$d
  while [ "$k" != . ] && [ ! -e "$k/kustomization.yaml" ] && [ ! -e "$k/kustomization.yml" ] && [ ! -e "$k/Kustomization" ]; do k=$(dirname "$k"); done
  [ "$k" = . ] || d=$k
  [ "$d" = . ] && continue
  case " $dirs " in *" $d "*) ;; *) dirs="$dirs $d" ;; esac
done <"$CHANGED"
[ -n "$dirs$values" ] || skip "no manifest changed"
schema() {
  local r
  r=$(kubeconform -strict -summary -ignore-missing-schemas -kubernetes-version "$KUBE_VERSION" -cache "$OUT/.schemas" \
    -schema-location default -schema-location "$CATALOG" "$2" 2>&1 | tail -n 3 | tr '\n' ' ')
  case "$r" in
    *"Errors: 0"*"Invalid: 0"* | *"Invalid: 0"*"Errors: 0"*) echo "PASS schema $1: ${r:0:200}" ;;
    *"no such host"* | *"i/o timeout"* | *"connection refused"*) skip "fetch blocked: schemas (${r:0:200})" ;;
    *) echo "FAIL schema $1: ${r:0:300}"; fail=1 ;;
  esac
}
mkdir -p "$OUT/.schemas"
for dir in $dirs; do
  out="$OUT/$(echo "$dir" | tr / _).yaml"
  if [ ! -e "$dir/kustomization.yaml" ] && [ ! -e "$dir/kustomization.yml" ] && [ ! -e "$dir/Kustomization" ]; then
    : >"$out"
    for f in "$dir"/*.yaml "$dir"/*.yml; do [ -f "$f" ] && { printf -- '---\n'; cat "$f"; printf '\n'; } >>"$out"; done
    [ -s "$out" ] || { echo "INFO render $dir: no manifests"; rm -f "$out"; continue; }
    echo "PASS render $dir (plain folder): $(grep -c '^kind:' "$out") objects"
  elif ! kustomize build --enable-helm "$dir" >"$out" 2>"$OUT/k.err"; then
    grep -q -E 'no such host|i/o timeout|connection refused' "$OUT/k.err" && skip "fetch blocked: $(tail -n 1 "$OUT/k.err" | cut -c1-200)"
    echo "FAIL render $dir: $(tail -n 5 "$OUT/k.err" | tr '\n' ' ' | cut -c1-300)"; fail=1; rm -f "$out"; continue
  else
    echo "PASS render $dir: $(grep -c '^kind:' "$out") objects"
  fi
  schema "$dir" "$out"
done
for vf in $values; do
  apps=$(grep -l -F -- "$vf" */apps/*.yml */apps/*.yaml 2>/dev/null | tr '\n' ' ')
  [ -n "$apps" ] || { echo "FAIL values $vf: no Argo CD Application names it"; fail=1; continue; }
  plan=$(for a in $apps; do yq -o=json '.' "$a"; done | python3 /usr/local/lib/check-manifests/plan.py "$vf")
  [ -n "$plan" ] || { echo "FAIL values $vf: no Helm source of an Application uses it"; fail=1; continue; }
  while IFS=$'\t' read -r app release ref repo version ns files inline; do
    [ -z "$inline" ] || skip "not rendered: app $app has inline Helm values"
    out="$OUT/values_${app}.yaml"
    set --
    for f in $files; do set -- "$@" -f "$f"; done
    if helm template "$release" "$ref" ${repo:+--repo "$repo"} --version "$version" -n "$ns" --include-crds --kube-version "$KUBE_VERSION" "$@" >"$out" 2>"$OUT/h.err"; then
      echo "PASS render $vf via app $app (chart ${ref##*/} $version): $(grep -c '^kind:' "$out") objects"
      schema "$app" "$out"
    else
      grep -q -E 'no such host|i/o timeout|connection refused|403|401' "$OUT/h.err" && skip "fetch blocked: chart $ref"
      echo "FAIL render $vf via app $app: $(grep -v '^WARNING' "$OUT/h.err" | tail -n 3 | tr '\n' ' ' | cut -c1-300)"; fail=1; rm -f "$out"
    fi
  done <<<"$plan"
done
pol=""
[ -z "${POLICIES:-}" ] || pol=$(grep -l -E '^kind: (ClusterPolicy|Policy|ValidatingPolicy|ValidatingAdmissionPolicy|ValidatingAdmissionPolicyBinding)$' "$POLICIES"/*.yaml 2>/dev/null | tr '\n' ' ')
if [ -n "${POLICIES:-}" ] && [ -z "$pol" ]; then
  echo "FAIL kyverno: no policies in $POLICIES"; fail=1
elif [ -n "$pol" ] && ls "$OUT"/*.yaml >/dev/null 2>&1; then
  kv="$OUT/kv"
  mkdir -p "$kv/pol"
  for f in "$OUT"/*.yaml; do yq -o=json -I=0 '.' "$f"; done >"$kv/res.jsonl"
  for p in $pol; do yq -o=json -I=0 '.' "$p" >"$kv/pol/$(basename "$p").jsonl"; done
  custom=$(python3 /usr/local/lib/check-manifests/split.py "$kv")
  if [ ! -s "$kv/all.yaml" ]; then
    echo "INFO kyverno: no built-in objects, $custom custom objects not checked"
  else
    tp=0; te=0; bad=""; runs=0
    while read -r p r; do
      runs=$((runs + 1))
      (cd "$kv" && kyverno apply "$p" --resource "$r") >"$OUT/kyverno.log" 2>&1
      line=$(grep -E '^pass: [0-9]+, fail: [0-9]+' "$OUT/kyverno.log" | tail -n 1)
      if [ -z "$line" ]; then bad="$bad $p: $(tail -n 2 "$OUT/kyverno.log" | tr '\n' ' ' | cut -c1-120)"; continue; fi
      n() { echo "$line" | sed -E "s/.*$1: ([0-9]+).*/\1/"; }
      tp=$((tp + $(n pass))); te=$((te + $(n error)))
      [ "$(n fail)" = 0 ] || bad="$bad $p fail $(n fail)"
    done <"$kv/jobs"
    if [ -z "$bad" ]; then echo "PASS kyverno $runs policy sets: pass $tp, fail 0, offline errors $te; $custom custom objects not checked"
    else echo "FAIL kyverno:${bad:0:300}"; fail=1; fi
  fi
fi
exit $fail
