{
  "env": {},
  "apps": [
    {
      "name": "The Sims Online",
      "cmd": "/opt/sims4/bin/openso-run",
      "prep-cmd": [
        {
          "do": "sh -c \". /tmp/runtime/session.env; swaymsg output HEADLESS-1 mode ${SUNSHINE_CLIENT_WIDTH:-1920}x${SUNSHINE_CLIENT_HEIGHT:-1080}@${SUNSHINE_CLIENT_FPS:-60}Hz\"",
          "undo": "/opt/sims4/bin/openso-run stop"
        }
      ],
      "auto-detach": "false",
      "wait-all": "true",
      "exclude-global-prep-cmd": "false",
      "image-path": "/opt/sims4/art/openso.png"
    },
    {
      "name": "Desktop (test)",
      "prep-cmd": [
        {
          "do": "sh -c \". /tmp/runtime/session.env; swaymsg output HEADLESS-1 mode ${SUNSHINE_CLIENT_WIDTH:-1920}x${SUNSHINE_CLIENT_HEIGHT:-1080}@${SUNSHINE_CLIENT_FPS:-60}Hz\"",
          "undo": ""
        }
      ],
      "auto-detach": "true",
      "wait-all": "true",
      "exclude-global-prep-cmd": "false",
      "image-path": "desktop.png"
    }
  ]
}
