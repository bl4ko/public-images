+static int64_t monotonic_ns(void) {
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
+}
+
+static void schedule_frame(struct wlr_headless_output *output) {
+	if (output->frame_armed) {
+		return;
+	}
+	int64_t now = monotonic_ns();
+	int64_t period = output->frame_period_ns;
+	if (output->next_frame_ns == 0) {
+		output->next_frame_ns = now + period;
+	} else if (output->next_frame_ns <= now) {
+		output->next_frame_ns += ((now - output->next_frame_ns) / period + 1) * period;
+	}
+	struct itimerspec its = {
+		.it_value = {
+			.tv_sec = output->next_frame_ns / 1000000000LL,
+			.tv_nsec = output->next_frame_ns % 1000000000LL,
+		},
+	};
+	if (timerfd_settime(output->frame_fd, TFD_TIMER_ABSTIME, &its, NULL) == 0) {
+		output->frame_armed = true;
+	}
+}
