#!/usr/bin/env bash
set -euo pipefail

APP=/opt/openso
CFG=/data/openso/config.ini
TSO=${OPENSO_TSO_DIR:-/tso}
API=${OPENSO_API_URL:-http://openso-server.openso.svc.cluster.local:9000}
LOGIN=${OPENSO_LOGIN_DIR:-/run/secrets/openso-owner}
GAMEDIR="${HOME}/Documents/The Sims Online"

stop() {
    if [[ -f /tmp/runtime/session.env ]]; then
        . /tmp/runtime/session.env
        swaymsg '[class="(?i)^openso$"] kill' >/dev/null 2>&1 || true
        for _ in $(seq 1 50); do
            pgrep -x OpenSO >/dev/null || return 0
            sleep 0.1
        done
    fi
    pkill -x OpenSO || true
    for _ in $(seq 1 50); do
        pgrep -x OpenSO >/dev/null || return 0
        sleep 0.1
    done
    pkill -9 -x OpenSO || true
}

set_ini() {
    if grep -q "^$1=" "${CFG}"; then
        sed -i "s#^$1=.*#$1=$2#" "${CFG}"
    else
        printf '%s=%s\n' "$1" "$2" >> "${CFG}"
    fi
}

if [[ "${1:-run}" == stop ]]; then
    stop
    exit 0
fi
[[ "${1:-}" == run ]] && shift

. /tmp/runtime/session.env
renice --priority 0 -p $$ >/dev/null 2>&1 || true

rm -f "${XDG_RUNTIME_DIR}/display"
swaymsg exec "printf %s \"\$DISPLAY\" > ${XDG_RUNTIME_DIR}/display" >/dev/null 2>&1 || true
for _ in $(seq 1 40); do [[ -s "${XDG_RUNTIME_DIR}/display" ]] && break; sleep 0.05; done
[[ -s "${XDG_RUNTIME_DIR}/display" ]] && DISPLAY="$(cat "${XDG_RUNTIME_DIR}/display")" && export DISPLAY

if [[ ! -f "${TSO}/TSOClient/tuning.dat" ]]; then
    echo "openso-run: The Sims Online files are missing at ${TSO}/TSOClient" >&2
    exit 1
fi

mkdir -p "${HOME}/Documents" /data/openso
rm -rf "${GAMEDIR}"
mkdir -p "${GAMEDIR}/TSOClient"
for e in "${TSO}"/*; do [[ "${e##*/}" == TSOClient ]] || ln -s "${e}" "${GAMEDIR}/"; done
ln -s "${TSO}"/TSOClient/* "${GAMEDIR}/TSOClient/"
touch "${CFG}"
ln -sfn "${CFG}" "${APP}/Content/config.ini"
read -r W H < <(swaymsg -t get_outputs | jq -r '.[0].current_mode | "\(.width) \(.height)"')
set_ini GameEntryUrl "${API}"
set_ini CitySelectorUrl "${API}"
set_ini Windowed false
set_ini GraphicsWidth "${SUNSHINE_CLIENT_WIDTH:-${W}}"
set_ini GraphicsHeight "${SUNSHINE_CLIENT_HEIGHT:-${H}}"
set_ini CompatState 2

export SDL_VIDEODRIVER=x11
export SDL_JOYSTICK_DISABLE_UDEV=1
export LD_PRELOAD="/opt/sims4/lib/libsims4-input.so${LD_PRELOAD:+:${LD_PRELOAD}}"
mkdir -p /data/openso/logs
exec > >(tee -a /data/openso/logs/openso-run.log) 2>&1

[[ -f /tmp/runtime/bench.env ]] && . /tmp/runtime/bench.env
if [[ -n "${SIMS4_BENCH_DIR:-}" ]]; then
    mkdir -p "${SIMS4_BENCH_DIR}/mangohud"
    export MANGOHUD=1
    export MANGOHUD_CONFIG="no_display,autostart_log=1,log_interval=0,log_duration=${SIMS4_BENCH_SECS:-60},output_folder=${SIMS4_BENCH_DIR}/mangohud"
    echo "launch $(date +%s.%N) openso" >> "${SIMS4_BENCH_DIR}/launch.txt"
fi

autologin() {
    local ini="${GAMEDIR}/TSOClient/login.ini"
    local pid prev cur calm=0
    inotifywait -qq -t 300 -e open "${ini}" || return 0
    pid=$(pgrep -nx OpenSO) || return 0
    prev=$(awk '{print $14+$15}' "/proc/${pid}/stat") || return 0
    for _ in $(seq 1 60); do
        sleep 1
        cur=$(awk '{print $14+$15}' "/proc/${pid}/stat") || return 0
        if (( cur - prev < 25 )); then calm=$((calm + 1)); else calm=0; fi
        prev=${cur}
        (( calm >= 2 )) && break
    done
    xdotool key --delay 20 End $(printf 'BackSpace %.0s' $(seq 1 64))
    xdotool type --delay 40 --file "${LOGIN}/password"
    xdotool keydown Return sleep 0.15 keyup Return
}

if [[ -s "${LOGIN}/username" && -s "${LOGIN}/password" && ( -z "${SIMS4_BENCH_DIR:-}" || -n "${OPENSO_BENCH_AUTOLOGIN:-}" ) ]]; then
    printf '[LastSession]\nUserName=%s\n' "$(cat "${LOGIN}/username")" > "${GAMEDIR}/TSOClient/login.ini"
    set_ini LastUser "$(cat "${LOGIN}/username")"
    autologin &
fi

cd "${APP}"
[[ -n "${SIMS4_BENCH_DIR:-}" ]] && exec mangohud --dlsym ./OpenSO "$@"
exec ./OpenSO "$@"
