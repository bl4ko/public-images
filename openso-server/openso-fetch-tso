#!/bin/bash
set -euo pipefail

fail() {
  echo "openso-fetch-tso: $*" >&2
  exit 1
}

: "${TSO_URL:?TSO_URL is required}"
: "${TSO_SHA256:?TSO_SHA256 is required}"
: "${TSO_SHA1:?TSO_SHA1 is required}"
: "${DEST:?DEST is required}"
TSO_SHA256=${TSO_SHA256,,}
TSO_SHA1=${TSO_SHA1,,}
[[ $TSO_SHA256 =~ ^[0-9a-f]{64}$ ]] || fail "TSO_SHA256 must be 64 hex characters"
[[ $TSO_SHA1 =~ ^[0-9a-f]{40}$ ]] || fail "TSO_SHA1 must be 40 hex characters"

DEST=${DEST%/}
client=$DEST/TSOClient
marker=$DEST/.tso-ok
work=$DEST/.tso-work

valid() {
  [ -f "$client/tuning.dat" ] && [ -s "$client/tuning.dat" ] || return 1
  for d in uigraphics objectdata packingslips sounddata; do
    [ -d "$client/$d" ] && [ -n "$(ls -A "$client/$d")" ] || return 1
  done
}

mkdir -p "$DEST"
if [ -f "$marker" ] && [ "$(cat "$marker")" = "$TSO_SHA256" ] && valid; then
  echo "openso-fetch-tso: $client already valid"
  exit 0
fi

rm -f "$marker"
rm -rf "$work/unzip"
mkdir -p "$work"
zip=$work/tso.zip

sums_ok() {
  echo "$TSO_SHA1  $zip" | sha1sum -c --quiet - && echo "$TSO_SHA256  $zip" | sha256sum -c --quiet -
}

if ! { [ -f "$zip" ] && sums_ok >/dev/null 2>&1; }; then
  echo "openso-fetch-tso: downloading $TSO_URL"
  rc=0
  curl -fL --no-progress-meter --retry 10 --retry-all-errors --retry-delay 10 -C - -o "$zip" "$TSO_URL" || rc=$?
  if [ "$rc" -ne 0 ]; then
    case $rc in 22 | 33 | 36) rm -f "$zip" ;; esac
    fail "download failed (curl exit $rc)"
  fi
  if ! sums_ok; then
    rm -f "$zip"
    fail "checksum mismatch"
  fi
fi

unzip -q "$zip" -d "$work/unzip"
rm -f "$zip"
cab=$(find "$work/unzip" -type f -iname Data1.cab | head -n 1)
[ -n "$cab" ] || fail "Data1.cab not found in archive"
rm -rf "$client"
cabextract -q -d "$DEST" "$cab"
valid || fail "$client failed validation after extraction"
rm -rf "$work"
printf '%s\n' "$TSO_SHA256" > "$marker.tmp"
mv "$marker.tmp" "$marker"
echo "openso-fetch-tso: $client ready"
