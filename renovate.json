{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranchPatterns": [
    "main"
  ],
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":pinDevDependencies"
  ],
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "matchFileNames": [
        "sims4/**"
      ],
      "automerge": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "automerge": true,
      "groupName": "github actions"
    },
    {
      "matchPackageNames": [
        "moby/buildkit"
      ],
      "groupName": "buildkit"
    },
    {
      "matchPackageNames": [
        "opencontainers/runc",
        "rootless-containers/rootlesskit"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "automerge": false
    },
    {
      "matchDatasources": [
        "github-tags"
      ],
      "matchPackageNames": [
        "moby/buildkit"
      ],
      "allowedVersions": "/^v\\d+\\.\\d+\\.\\d+$/"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.github/workflows/.+\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+\\w+:\\s+(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate-commit: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARG \\w+_VERSION=(?<currentValue>\\S+)\\s+ARG \\w+_COMMIT=(?<currentDigest>[0-9a-f]{40})"
      ]
    }
  ],
  "platformAutomerge": true,
  "rebaseWhen": "behind-base-branch",
  "prConcurrentLimit": 5,
  "timezone": "Europe/Ljubljana",
  "minimumReleaseAge": "3 days"
}
